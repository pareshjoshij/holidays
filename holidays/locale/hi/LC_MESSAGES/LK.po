#. %s (estimated).
#, c-format
msgid "%s (අනුමානිත)"
msgstr "%s (अनुमानित)"

#. Tamil Thai Pongal Day.
msgid "දෙමළ තෛපොංැලල් දිනය"
msgstr "तमिल थाई पोंगल दिवस"

#. Independence Day.
msgid "නිදහස් සමරු දිනය"
msgstr "स्वतंत्रता दिवस"

#. Sinhala and Tamil New Year.
msgid "සිංහල හා දෙමළ අලුත් අවුරුදු දිනය"
msgstr "सिंहल और तमिल नव वर्ष"

#. Day Before Sinhala and Tamil New Year.
msgid "සිංහල හා දෙමළ අලුත් අවුරුදු දිනට පෙර දිනය"
msgstr "सिंहल और तमिल नव वर्ष से पूर्व का दिन"

#. Good Friday.
msgid "මහ සිකුරාදා දිනය"
msgstr "गुड फ्राइडे"

#. International Workers' Day.
msgid "ලොක කම්කරු දිනය"
msgstr "अंतर्राष्ट्रीय श्रमिक दिवस"

#. Christmas Day.
msgid "නත්තල් උත්සව දිනය"
msgstr "क्रिसमस दिवस"

#. Maha Sivarathri Day.
msgid "මහ සිවරාත්රි දිනය"
msgstr "महा शिवरात्रि"

#. Deepavali Festival Day.
msgid "දීපවාලි උත්සව දිනය"
msgstr "दीपावली त्योहार"

#. Duruthu Full Moon Poya Day.
msgid "දුරුතු පුර පසළොස්වක පෝය දිනය"
msgstr "दुरूतू पूर्णिमा पोया"

#. Nawam Full Moon Poya Day.
msgid "නවම් පුර පසළොස්වක පෝය දිනය"
msgstr "नवम पूर्णिमा पोया"

#. Medin Full Moon Poya Day.
msgid "මැදින් පුර පසළොස්වක පෝය දිනය"
msgstr "मेदिन पूर्णिमा पोया"

#. Bak Full Moon Poya Day.
msgid "බක් පුර පසළොස්වක පෝය දිනය"
msgstr "बक पूर्णिमा पोया"

#. Vesak Full Moon Poya Day.
msgid "වෙසක් පුර පසළොස්වක පෝය දිනය"
msgstr "वेसाक पूर्णिमा पोया"

#. Day Following Vesak Full Moon Poya Day.
msgid "වෙසක් පුර පසළොස්වක පෝය දිනට පසු දිනය"
msgstr "वेसाक पूर्णिमा पोया के बाद का दिन"

#. Poson Full Moon Poya Day.
msgid "පොසොන් පුර පසළොස්වක පෝය දිනය"
msgstr "पोसोन पूर्णिमा पोया"

#. Esala Full Moon Poya Day.
msgid "ඇසල පුර පසළොස්වක පෝය දිනය"
msgstr "एसाला पूर्णिमा पोया"

#. Nikini Full Moon Poya Day.
msgid "නිකිණි පුර පසළොස්වක පෝය දිනය"
msgstr "निकिनी पूर्णिमा पोया"

#. Binara Full Moon Poya Day.
msgid "බිනර පුර පසළොස්වක පෝය දිනය"
msgstr "बिनारा पूर्णिमा पोया"

#. Vap Full Moon Poya Day.
msgid "වප් පුර පසළොස්වක පෝය දිනය"
msgstr "वप पूर्णिमा पोया"

#. Il Full Moon Poya Day.
msgid "ඉල් පුර පසළොස්වක පෝය දිනය"
msgstr "इल पूर्णिमा पोया"

#. Unduvap Full Moon Poya Day.
msgid "උඳුවප් පුර පසළොස්වක පෝය දිනය"
msgstr "उंदुवप पूर्णिमा पोया"

#. Eid al-Fitr.
msgid "ඊදුල් ෆීතර්"
msgstr "ईद-उल-फितर"

#. Eid al-Adha.
msgid "ඊදුල් අල්හා"
msgstr "ईद-उल-अज़हा"

#. Prophet's Birthday.
msgid "නබි නායකතුමාගේ උපන් දිනය"
msgstr "पैगंबर का जन्मदिन (मिलाद-उन-नबी)"

#. Adhi Binara Full Moon Poya Day.
msgid "අධි බිනර පුර පසළොස්වක පෝය දිනය"
msgstr "अधि बिनारा पूर्णिमा पोया"

#. Adhi Esala Full Moon Poya Day.
msgid "අධි ඇසල පුර පසළොස්වක පෝය දිනය"
msgstr "अधि एसाला पूर्णिमा पोया"

#. Adhi Poson Full Moon Poya Day.
msgid "අධි පොසොන් පුර පසළොස්වක පෝය දිනය"
msgstr "अधि पोसोन पूर्णिमा पोया"

#. Adhi Vap Full Moon Poya Day.
msgid "අධි වප් පුර පසළොස්වක පෝය දිනය"
msgstr "अधि वप पूर्णिमा पोया"

#. Adhi Vesak Full Mon Poya Day.
msgid "අධි වෙසක් පුර පසළොස්වක පෝය දිනය"
msgstr "अधि वेसाक पूर्णिमा पोया"

#. Half-Day Special Bank Holiday.
msgid "දින භාගයක විශේෂ බැංකු නිවාඩු දිනය"
msgstr "आधे दिन का विशेष बैंक अवकाश"

#. Public Sector Holiday.
msgid "රාජ්ය අංශයේ නිවාඩු දිනය"
msgstr "सार्वजनिक क्षेत्र का अवकाश"

#. Special Bank Holiday.
msgid "විශේෂ බැංකු නිවාඩු දිනය"
msgstr "विशेष बैंक अवकाश"

#. Special Public Holiday.
msgid "විශේෂ රජයේ නිවාඩු දිනය"
msgstr "विशेष सार्वजनिक अवकाश"
